#!/usr/bin/env bash
set -euo pipefail

if [ "$(id -un)" != "pitv" ]; then
  echo "Waydroid TV aplikace musí běžet v session uživatele pitv." >&2
  exit 12
fi

export HOME=/home/pitv
export USER=pitv
export LOGNAME=pitv

MODE="outer"
if [ "${1:-}" = "--cage-client" ]; then
  MODE="client"
  shift
fi

TARGET="${1:-}"
APK="${2:-}"
[ -n "$TARGET" ] || exit 2

RUNTIME="/run/user/$(id -u)"
export XDG_RUNTIME_DIR="$RUNTIME"
export XDG_SESSION_TYPE="wayland"
export PULSE_RUNTIME_PATH="$RUNTIME/pulse"
export DBUS_SESSION_BUS_ADDRESS="unix:path=$RUNTIME/bus"

LOG="/tmp/pitv-waydroid-launch.log"
[ "$MODE" = "client" ] || : >"$LOG"

log() {
  printf '%s\n' "PiTV: $*" >>"$LOG"
}

valid_package() {
  [[ "$1" =~ ^[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z0-9_]+)+$ ]]
}

# Only use a Wayland socket owned by the canonical pitv runtime. The outer
# process starts in labwc; when Cage starts the client it replaces
# WAYLAND_DISPLAY with Cage's nested socket in the same runtime.
VALID_WAYLAND=""
if [ -n "${WAYLAND_DISPLAY:-}" ]; then
  if [[ "$WAYLAND_DISPLAY" = "$RUNTIME/"* ]] && [ -S "$WAYLAND_DISPLAY" ]; then
    VALID_WAYLAND="$(basename "$WAYLAND_DISPLAY")"
  elif [[ "$WAYLAND_DISPLAY" != /* ]] && [ -S "$RUNTIME/$WAYLAND_DISPLAY" ]; then
    VALID_WAYLAND="$WAYLAND_DISPLAY"
  fi
fi
if [ -z "$VALID_WAYLAND" ]; then
  for socket in "$RUNTIME"/wayland-*; do
    if [ -S "$socket" ]; then
      VALID_WAYLAND="$(basename "$socket")"
      break
    fi
  done
fi
if [ -z "$VALID_WAYLAND" ]; then
  log "WAYLAND_DISPLAY is missing in $RUNTIME"
  exit 11
fi
export WAYLAND_DISPLAY="$VALID_WAYLAND"

if [ ! -S "$RUNTIME/bus" ]; then
  log "PiTV user D-Bus is missing: $RUNTIME/bus"
  exit 13
fi

# Waydroid bind-mounts the host Pulse-compatible socket into Android.
if [ ! -S "$RUNTIME/pulse/native" ]; then
  systemctl --user start pipewire.socket pipewire-pulse.socket wireplumber.service >>"$LOG" 2>&1 || true
  for _ in $(seq 1 50); do
    [ -S "$RUNTIME/pulse/native" ] && break
    sleep 0.1
  done
fi
if [ ! -S "$RUNTIME/pulse/native" ]; then
  log "audio socket missing: $RUNTIME/pulse/native"
  exit 9
fi

# Raspberry Pi Waydroid preflight. 16 KiB page-size kernels are known to be
# unsuitable for this runtime path, and PSI must be available.
if [ "$(uname -m)" = "aarch64" ]; then
  PAGE_SIZE="$(getconf PAGESIZE 2>/dev/null || true)"
  if [ -n "$PAGE_SIZE" ] && [ "$PAGE_SIZE" != "4096" ]; then
    log "unsupported page size for Waydroid on Raspberry Pi: $PAGE_SIZE (expected 4096)"
    exit 14
  fi
  if [ ! -d /proc/pressure ]; then
    log "PSI is unavailable (/proc/pressure missing); enable psi=1 and reboot"
    exit 15
  fi
fi

wait_ready() {
  local ready=0
  for _ in $(seq 1 180); do
    if printf '{}' |
        sudo -n /usr/local/libexec/pitv-helper waydroid-ready >/dev/null 2>&1; then
      ready=1
      break
    fi
    sleep 0.5
  done
  [ "$ready" -eq 1 ]
}

package_installed() {
  local package="$1"
  waydroid app list 2>>"$LOG" |
    awk -F': *' '/^packageName:/ {print $2}' |
    grep -Fxq "$package"
}

launch_package() {
  local package="$1"
  waydroid app launch "$package" >>"$LOG" 2>&1 || return 1

  # Waydroid can return successfully before the Android process/window becomes
  # observable. Verify the package before reporting launch success.
  for _ in $(seq 1 40); do
    if printf '{"package":"%s"}' "$package" |
        sudo -n /usr/local/libexec/pitv-helper waydroid-app-running >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.25
  done
  return 1
}

if [ "$MODE" = "outer" ]; then
  if ! command -v cage >/dev/null 2>&1; then
    log "Cage kiosk compositor is not installed"
    exit 16
  fi

  # A Waydroid session is bound to the Wayland socket that existed when the
  # session started. Stop any stale labwc-bound session before entering Cage;
  # otherwise show-full-ui would reuse it instead of binding Android to Cage.
  waydroid session stop >>"$LOG" 2>&1 || true
  for _ in $(seq 1 50); do
    if ! waydroid status 2>/dev/null | grep -Eq '^Session:[[:space:]]*RUNNING'; then
      break
    fi
    sleep 0.1
  done

  log "starting nested Cage fullscreen session from parent $WAYLAND_DISPLAY"

  # This follows Waydroid's documented kiosk/fullscreen model. Cage detects the
  # existing labwc Wayland session and opens a nested virtual output. labwc
  # maximizes that wlroots window via system/labwc/rc.xml.
  exec cage -d -- "$0" --cage-client "$TARGET" "$APK"
fi

# From this point we are the single Cage client. Cage has replaced
# WAYLAND_DISPLAY with its own nested socket, so Waydroid's session manager
# binds Android to Cage rather than directly to PiTV/labwc.
export XDG_CURRENT_DESKTOP="cage"
log "Cage client socket: $WAYLAND_DISPLAY"

UI_PID=""
cleanup() {
  waydroid session stop >/dev/null 2>&1 || true
  if [ -n "$UI_PID" ]; then
    wait "$UI_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT TERM INT HUP

# Use Waydroid's own documented fullscreen entry point. When no session exists,
# upstream starts a foreground (background_start=false) user session here.
waydroid show-full-ui >>"$LOG" 2>&1 &
UI_PID=$!

if ! wait_ready; then
  log "Android framework did not become ready inside Cage"
  waydroid status >>"$LOG" 2>&1 || true
  waydroid log >>"$LOG" 2>&1 || true
  exit 3
fi

# PiTV is a TV appliance, not a desktop multi-window environment. Persisted
# Waydroid data survives PiTV updates, so force the documented full-UI mode
# every time rather than inheriting an old multi_windows=true setting.
if ! waydroid prop set persist.waydroid.multi_windows false >>"$LOG" 2>&1; then
  log "failed to force persist.waydroid.multi_windows=false"
  exit 17
fi
MULTI="$(waydroid prop get persist.waydroid.multi_windows 2>>"$LOG" || true)"
log "persist.waydroid.multi_windows=${MULTI:-unknown}"

# The shared PiTV media bind is privileged. At this point the Android container
# is already running, so the helper only verifies it and attaches the media
# bridge; it does not choose the Wayland socket.
if ! sudo -n /usr/local/libexec/pitv-helper waydroid-container-start </dev/null >>"$LOG" 2>&1; then
  log "Waydroid is ready but PiTV Media bridge failed"
  exit 10
fi

TRACK_PACKAGE=""
if [ "$TARGET" = "--full-ui" ]; then
  # Keep the documented full Android UI alive until PiTV stops this process
  # group or the Waydroid session exits.
  wait "$UI_PID"
  exit $?
elif [ "$TARGET" = "--play-store" ]; then
  PACKAGE="$APK"
  valid_package "$PACKAGE" || exit 6
  package_installed "com.android.vending" || exit 7
  if ! printf '{"package":"%s"}' "$PACKAGE" |
      sudo -n /usr/local/libexec/pitv-helper waydroid-open-play-store >>"$LOG" 2>&1; then
    launch_package "com.android.vending" || exit 8
  fi
  TRACK_PACKAGE="com.android.vending"
else
  valid_package "$TARGET" || {
    log "invalid package ID: $TARGET"
    exit 2
  }

  if [ -n "$APK" ] && [ -f "$APK" ] && ! package_installed "$TARGET"; then
    waydroid app install "$APK" >>"$LOG" 2>&1 || exit 4
  fi

  if ! package_installed "$TARGET"; then
    log "package is not installed after install step: $TARGET"
    exit 4
  fi

  if ! launch_package "$TARGET"; then
    log "first app launch did not create a running window/process; retrying"
    sleep 1
    if ! launch_package "$TARGET"; then
      log "application failed to start: $TARGET"
      waydroid log >>"$LOG" 2>&1 || true
      exit 5
    fi
  fi
  TRACK_PACKAGE="$TARGET"
fi

# Keep Cage and the upstream Waydroid session alive while the selected Android
# package is alive. Once the app closes, the trap stops the session and Cage
# disappears, revealing PiTV again.
MISSES=0
while printf '{}' |
    sudo -n /usr/local/libexec/pitv-helper waydroid-ready >/dev/null 2>&1; do
  if [ -n "$TRACK_PACKAGE" ]; then
    if printf '{"package":"%s"}' "$TRACK_PACKAGE" |
        sudo -n /usr/local/libexec/pitv-helper waydroid-app-running >/dev/null 2>&1; then
      MISSES=0
    else
      MISSES=$((MISSES + 1))
      [ "$MISSES" -ge 3 ] && break
    fi
  fi
  sleep 1
done
