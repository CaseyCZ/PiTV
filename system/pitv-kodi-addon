#!/usr/bin/env bash
set -euo pipefail

if [ "$(id -un)" != "pitv" ]; then
  echo "Kodi/Plex musí běžet v TV session uživatele pitv." >&2
  exit 10
fi
export HOME=/home/pitv
export USER=pitv
export LOGNAME=pitv
RUNTIME="/run/user/$(id -u)"
export XDG_RUNTIME_DIR="$RUNTIME"
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=labwc
export PULSE_RUNTIME_PATH="$RUNTIME/pulse"
export DBUS_SESSION_BUS_ADDRESS="unix:path=$RUNTIME/bus"

if [ ! -S "$RUNTIME/bus" ] || [ ! -S "$RUNTIME/pulse/native" ]; then
  echo "PiTV TV session (D-Bus/PipeWire) není připravená." >&2
  exit 11
fi
MARKER="$RUNTIME/pitv-wayland-display"
WAYLAND_DISPLAY="$(head -n1 "$MARKER" 2>/dev/null || true)"
if [[ ! "$WAYLAND_DISPLAY" =~ ^wayland-[0-9]+$ ]] ||
   [ ! -S "$RUNTIME/$WAYLAND_DISPLAY" ]; then
  WAYLAND_DISPLAY=""
fi
export WAYLAND_DISPLAY
[ -n "${WAYLAND_DISPLAY:-}" ] || { echo "PiTV Wayland není připravený." >&2; exit 12; }

MODE="${1:-run}"
ADDON="${2:-script.plexmod}"

case "$ADDON" in
  script.plexmod|script.plex) ;;
  *) echo "Nepovolený Kodi add-on: $ADDON" >&2; exit 2 ;;
esac

command -v kodi >/dev/null 2>&1 || { echo "Kodi není nainstalované" >&2; exit 3; }
command -v kodi-send >/dev/null 2>&1 || { echo "kodi-send není dostupný" >&2; exit 4; }

# Start Kodi through PiTV's persistent lifecycle wrapper. The distro
# /usr/bin/kodi process can exit while kodi.bin survives under PID 1; the
# wrapper remains alive until the real player is gone.
command -v pitv-kodi-launch >/dev/null 2>&1 || {
  echo "pitv-kodi-launch není dostupný" >&2
  exit 13
}
pitv-kodi-launch >/tmp/pitv-kodi.log 2>&1 &
KODI_PID=$!

cleanup() {
  if kill -0 "$KODI_PID" 2>/dev/null; then
    kill -TERM "$KODI_PID" 2>/dev/null || true
  fi
}
trap cleanup TERM INT HUP

# kodi-send returns successfully only once Kodi's event server is ready.
READY=0
for _ in $(seq 1 40); do
  if kodi-send --action="UpdateAddonRepos" >/dev/null 2>&1; then
    READY=1
    break
  fi
  kill -0 "$KODI_PID" 2>/dev/null || { wait "$KODI_PID" || true; exit 5; }
  sleep 0.5
done

if [ "$READY" -ne 1 ]; then
  echo "Kodi se nepodařilo připravit pro Plex" >&2
  cleanup
  wait "$KODI_PID" || true
  exit 6
fi

if [ "$MODE" = "install" ]; then
  # PM4K is present in the official Kodi add-on repository for Kodi 20/21+.
  # InstallAddon resolves its Python dependencies through Kodi itself.
  kodi-send --action="InstallAddon($ADDON)" >/dev/null 2>&1 || true
  for _ in $(seq 1 180); do
    if [ -f "$HOME/.kodi/addons/$ADDON/addon.xml" ] || [ -f "/usr/share/kodi/addons/$ADDON/addon.xml" ]; then
      break
    fi
    kill -0 "$KODI_PID" 2>/dev/null || break
    sleep 1
  done
fi

if [ -f "$HOME/.kodi/addons/$ADDON/addon.xml" ] || [ -f "/usr/share/kodi/addons/$ADDON/addon.xml" ]; then
  kodi-send --action="RunAddon($ADDON)" >/dev/null 2>&1 || true
else
  # Keep Kodi visible so the user can complete any repository confirmation
  # dialog with the TV remote; PiTV will re-check the add-on after Kodi exits.
  kodi-send --action="ActivateWindow(addonbrowser)" >/dev/null 2>&1 || true
fi

wait "$KODI_PID"
