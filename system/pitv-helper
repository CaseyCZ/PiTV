elif action == "waydroid-app-running":
    package = str(payload.get("package", "")).strip()
    if not re.fullmatch(r"[A-Za-z][A-Za-z0-9_]*(?:\.[A-Za-z0-9_]+)+", package):
        out("Neplatný Android package ID", 2)
    p = subprocess.run(
        ["waydroid", "shell", "pidof", package],
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        text=True, timeout=10, check=False,
    )
    if p.returncode == 0 and (p.stdout or "").strip():
        out("running")
    p = subprocess.run(
        ["waydroid", "shell", "dumpsys", "window", "windows"],
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        text=True, timeout=15, check=False,
    )
    if p.returncode == 0 and package in (p.stdout or ""):
        out("running")
    out("Android aplikace zatím neběží", 4)

elif action == "waydroid-app-session-active":
    package = str(payload.get("package", "")).strip()
    if not re.fullmatch(r"[A-Za-z][A-Za-z0-9_]*(?:\.[A-Za-z0-9_]+)+", package):
        out("Neplatný Android package ID", 2)

    # The visible Android Activity is authoritative. Android commonly keeps an
    # app process cached after Back reaches Home, so pidof alone cannot tell
    # whether the TV session is still inside that app flow.
    top = subprocess.run(
        ["waydroid", "shell", "dumpsys", "activity", "top"],
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        text=True, timeout=6, check=False,
    )
    top_package = parse_android_top_package(top.stdout or "")

    if top.returncode == 0 and top_package:
        if android_tv_session_active(top_package, top_ok=True):
            out(f"active:{top_package}")
        out(f"Android Home je aktivní: {top_package}", 4)

    # ActivityManager can be briefly unavailable while Android is switching
    # activities. In that case fall back to the target process and prefer not
    # to eject the user because of one transient dumpsys failure.
    p = subprocess.run(
        ["waydroid", "shell", "pidof", package],
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        text=True, timeout=5, check=False,
    )
    target_running = p.returncode == 0 and bool((p.stdout or "").strip())
    if android_tv_session_active(
            top_package, target_running=target_running,
            top_ok=(top.returncode == 0)):
        out("active:fallback")

    out("Android TV session už není aktivní", 4)

elif action == "waydroid-app-visible":
    package = str(payload.get("package", "")).strip()
    if not re.fullmatch(r"[A-Za-z][A-Za-z0-9_]*(?:\.[A-Za-z0-9_]+)+", package):
        out("Neplatný Android package ID", 2)

    # Fast path: one ActivityManager query is enough for the overwhelmingly
    # common cases. If the target itself is on top, it is ready immediately.
    # If Android Home is on top, it is not ready. Only delegated first-run
    # system surfaces need the extra pidof check.
    top = subprocess.run(
        ["waydroid", "shell", "dumpsys", "activity", "top"],
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        text=True, timeout=5, check=False,
