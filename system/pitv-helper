        out(f"Android Home je stále aktivní: {top_package}", 4)

    proc = subprocess.run(
        ["waydroid", "shell", "pidof", package],
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        text=True, timeout=5, check=False,
    )
    target_running = proc.returncode == 0 and bool((proc.stdout or "").strip())

    if android_app_launch_visible(
            package, top_package,
            target_running=target_running,
            top_ok=(top.returncode == 0)):
        out(f"visible:{top_package or package}")

    out("Android aplikace zatím nevytvořila aktivní TV flow", 4)

