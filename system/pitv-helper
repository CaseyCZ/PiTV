def parse_android_top_package(text):
    text = text or ""
    patterns = (
        r"(?m)^\s*ACTIVITY\s+([A-Za-z][A-Za-z0-9_]*(?:\.[A-Za-z0-9_]+)+)/",
        r"mResumedActivity:.*?\s([A-Za-z][A-Za-z0-9_]*(?:\.[A-Za-z0-9_]+)+)/",
        r"topResumedActivity=.*?\s([A-Za-z][A-Za-z0-9_]*(?:\.[A-Za-z0-9_]+)+)/",
    )
    for pattern in patterns:
        match = re.search(pattern, text)
        if match:
            return match.group(1)
    return ""


def android_tv_session_active(top_package, target_running=False, top_ok=True):
    """Return whether the viewer is still inside one Android TV app flow."""
    if top_ok and top_package:
        return top_package not in ANDROID_HOME_PACKAGES
    if target_running:
        return True
    # A transient ActivityManager error is not evidence that the user left.
    return not top_ok


def android_app_launch_visible(target_package, top_package,
                               target_running=False, top_ok=True):
    """Return whether a requested Android app has entered a visible app flow.

    A TV app can immediately delegate foreground to Android Settings,
    permission controller, account picker, splash/provisioning activity, etc.
    Requiring the exact target package to remain the top activity makes PiTV
    falsely retry an already successful launch.  Home is the only authoritative
    non-app surface; otherwise accept a delegated foreground while the target
    process exists.  If ActivityManager is transiently unavailable, a running
    target process is preferable to issuing a duplicate launch intent.
    """
    if top_ok and top_package:
        if top_package == target_package:
            return True
        if top_package in ANDROID_HOME_PACKAGES:
            return False
        return bool(target_running)
    return bool(target_running)


def out(msg, code=0):
    print(msg)
    raise SystemExit(code)

def run(args, timeout=600, stdin=None, env=None):
    args = list(args)
    # All APT actions launched from PiTV must coexist with Ubuntu's automatic
    # unattended-upgrades. Wait for the package-manager lock instead of failing
    # immediately with code 100 or deleting lock files.
    if args and os.path.basename(args[0]) == "apt-get":
        has_lock_timeout = any("DPkg::Lock::Timeout=" in str(x) for x in args)
        if not has_lock_timeout:
            args[1:1] = ["-o", "DPkg::Lock::Timeout=600"]
        # The process timeout must be longer than APT's own 600 s lock wait,
        # otherwise PiTV would abort while apt-get is still correctly waiting
        # for unattended-upgrades. Keep another five minutes for the actual
        # update/install/remove work after the lock becomes available.
        timeout = max(timeout, 900)
    p = subprocess.run(args, input=stdin, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                       text=True, timeout=timeout, check=False, env=env)
    text = (p.stdout or "").strip()
    if p.returncode != 0:
        out(text or f"Chyba ({p.returncode})", p.returncode)
    return text


MEDIA_HOST = "/srv/pitv/Media"
WAYDROID_MEDIA = "/var/lib/waydroid/data/media/0/PiTV-Media"
KODI_APPLIANCE_SOURCE = "/etc/pitv/kodi-appliance.xml"
KODI_APPLIANCE_TARGET = "/usr/share/kodi/system/settings/appliance.xml"


def ensure_kodi_appliance_defaults():
    """Merge PiTV's Pi 4 DRM PRIME defaults into Kodi's appliance settings."""
    source = KODI_APPLIANCE_SOURCE
    target = KODI_APPLIANCE_TARGET
    if not os.path.isfile(source):
        raise RuntimeError("PiTV Kodi appliance konfigurace chybí")
    target_dir = os.path.dirname(target)
    if not os.path.isdir(target_dir):
        raise RuntimeError("Kodi system settings adresář neexistuje")

    desired = {
        "videoplayer.useprimedecoder": "true",
        "videoplayer.useprimedecoderforhw": "true",
    }

    if os.path.exists(target):
        try:
            tree = ET.parse(target)
            root = tree.getroot()
        except Exception as e:
            raise RuntimeError(f"Stávající Kodi appliance.xml nelze načíst: {e}")
        if root.tag != "settings":
            raise RuntimeError("Stávající Kodi appliance.xml nemá kořen <settings>")
    else:
        # Start from the PiTV file so the structure stays identical to the
        # documented Kodi appliance override format used by LibreELEC/CoreELEC.
        tree = ET.parse(source)
        root = tree.getroot()

    by_id = {
        node.get("id"): node
        for node in root.iter("setting")
        if node.get("id")
    }

    # Reuse/create player -> videoplayer -> group 3. Kodi merges appliance
    # definitions into the existing Linux setting definitions by ID.
    section = next(
        (x for x in root.findall("section") if x.get("id") == "player"), None
    )
    if section is None:
        section = ET.SubElement(root, "section", {"id": "player"})
    category = next(
        (x for x in section.findall("category") if x.get("id") == "videoplayer"),
        None,
    )
    if category is None:
        category = ET.SubElement(section, "category", {"id": "videoplayer"})
    group = next(
        (x for x in category.findall("group") if x.get("id") == "3"), None
    )
    if group is None:
        group = ET.SubElement(category, "group", {"id": "3"})

    changed = False
    for setting_id, value in desired.items():
        setting = by_id.get(setting_id)
        if setting is None:
            setting = ET.SubElement(group, "setting", {"id": setting_id})
            changed = True
        default = setting.find("default")
        if default is None:
            default = ET.SubElement(setting, "default")
            changed = True
        if (default.text or "").strip().lower() != value:
            default.text = value
            changed = True

    if not os.path.exists(target) or changed:
        fd, tmp = tempfile.mkstemp(
            prefix="appliance.xml-", suffix=".tmp", dir=target_dir
        )
        os.close(fd)
        try:
            tree.write(tmp, encoding="utf-8", xml_declaration=True)
            os.chmod(tmp, 0o644)
            os.replace(tmp, target)
        finally:
            if os.path.exists(tmp):
                os.unlink(tmp)
    return target


def ensure_waydroid_media_bridge():
    """Expose PiTV's persistent Media folder inside Android shared storage."""
    os.makedirs(MEDIA_HOST, mode=0o777, exist_ok=True)
    os.chmod(MEDIA_HOST, 0o777)
    os.makedirs(WAYDROID_MEDIA, mode=0o777, exist_ok=True)

    mounted = subprocess.run(
        ["mountpoint", "-q", WAYDROID_MEDIA],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    ).returncode == 0
    if not mounted:
        p = subprocess.run(
            ["mount", "--bind", MEDIA_HOST, WAYDROID_MEDIA],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            timeout=20,
            check=False,
        )
        if p.returncode != 0:
            raise RuntimeError((p.stdout or "").strip() or "bind mount PiTV Media selhal")

