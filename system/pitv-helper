elif action == "waydroid-app-launch":
    package = str(payload.get("package", "")).strip()
    if not re.fullmatch(r"[A-Za-z][A-Za-z0-9_]*(?:\.[A-Za-z0-9_]+)+", package):
        out("Neplatný Android package ID", 2)

    # Mirror the host-side state that upstream `waydroid app launch` normally
    # publishes before starting an Activity. In Waydroid single-window mode the
    # HWC exports only the package named by waydroid.active_apps. Direct
    # `am start` without this leaves the Android Activity resumed/focused but
    # gives Cage only a black/full-UI surface. policy_control=immersive.status=*
    # matches upstream's non-multi-window launch mode.
    prepared = waydroid_shell(
        [
            "sh", "-c",
            "setprop waydroid.active_apps "
            + shlex.quote(package)
            + " && settings put global policy_control 'immersive.status=*'",
        ],
        timeout=15,
    )
    if prepared.returncode != 0:
        out(
            (prepared.stdout or "").strip()
            or "Waydroid active-app export nelze připravit",
            5,
        )

    active = waydroid_shell(["getprop", "waydroid.active_apps"], timeout=10)
    active_value = (active.stdout or "").strip()
    if active.returncode != 0 or active_value != package:
        out(
            "Waydroid active-app export se nepotvrdil: "
            + (active_value or f"rc={active.returncode}"),
            5,
        )

    component = ""
    category = ""
    diagnostics = []
    for candidate_category in (
        "android.intent.category.LEANBACK_LAUNCHER",
        "android.intent.category.LAUNCHER",
    ):
        resolved = waydroid_shell(
            [
                "cmd", "package", "resolve-activity",
                "--brief", "--user", "0",
                "-a", "android.intent.action.MAIN",
                "-c", candidate_category,
                package,
            ],
            timeout=15,
        )
        diagnostics.append((resolved.stdout or "").strip())
        if resolved.returncode == 0:
            component = resolve_android_launcher_component(
                resolved.stdout or "", package
            )
            if component:
                category = candidate_category
                break

    if not component:
        out(
            "Android launcher Activity nenalezena: "
            + " | ".join(x for x in diagnostics if x)[-800:],
            4,
        )

    launched = waydroid_shell(
        [
            "am", "start", "--user", "0", "-W",
            "-a", "android.intent.action.MAIN",
            "-c", category,
            "-n", component,
        ],
        timeout=30,
    )
    launch_text = (launched.stdout or "").strip()
    if launched.returncode != 0 or re.search(
            r"(?im)^\s*(?:error|exception):", launch_text):
        out(launch_text or "Android Activity se nepodařilo spustit", 5)
    out(f"launched:{component} active_apps={active_value}")

