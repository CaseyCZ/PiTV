elif action == "tv-runtime-reset":
    """Return the appliance to one clean PiTV TV session.

    This is intentionally narrow. It stops only runtimes PiTV itself owns:
    Waydroid/Cage, Kodi/Plex and the native Stremio Flatpak. Background server
    services such as Homebridge, Tailscale and Docker are untouched.
    """
    try:
        pitv = pwd.getpwnam("pitv")
        pitv_uid = pitv.pw_uid
    except KeyError:
        out("Uživatel pitv neexistuje", 2)

    runtime = f"/run/user/{pitv_uid}"
    pitv_env = [
        "env",
        "HOME=/home/pitv",
        "USER=pitv",
        "LOGNAME=pitv",
        f"XDG_RUNTIME_DIR={runtime}",
        f"DBUS_SESSION_BUS_ADDRESS=unix:path={runtime}/bus",
        f"PULSE_RUNTIME_PATH={runtime}/pulse",
    ]

    def run_as_pitv(args, timeout=20):
        return subprocess.run(
            ["runuser", "-u", "pitv", "--", *pitv_env, *args],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=timeout,
            check=False,
        )

    # The CEC monitor is launched through sudo and therefore runs as root.
    # If the Python launcher is killed/restarted, that child can survive as an
    # orphan and compete with the next launcher for the same adapter. PiTV
    # 1.4.10 effectively had one monitor for the launcher lifetime; enforce the
    # same invariant at every supervisor/session recovery boundary.
    stale_cec = []
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        try:
            with open(f"/proc/{entry}/cmdline", "rb") as proc_cmd:
                raw = proc_cmd.read().split(b"\x00")
            argv = [part.decode("utf-8", "replace") for part in raw if part]
        except (OSError, PermissionError):
            continue
        if (len(argv) == 5 and os.path.basename(argv[0]) == "cec-ctl"
                and argv[1] == "-d"
                and re.fullmatch(r"/dev/cec[0-9]+", argv[2])
                and argv[3:] == ["--monitor", "--show-raw"]):
            stale_cec.append(int(entry))

    for pid in stale_cec:
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    if stale_cec:
        time.sleep(0.20)
    for pid in stale_cec:
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            continue
        try:
            os.kill(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass

    # Stop the user Waydroid session through the same pitv D-Bus it was
    # created on. Running "waydroid session stop" as root would target the
    # wrong session bus and can leave the Android surface visible.
    if shutil.which("waydroid"):
        try:
            run_as_pitv(["waydroid", "session", "stop"], timeout=20)
        except Exception:
            pass

    # Kill only PiTV-owned foreground clients. Cage is the nested Android
    # compositor. Kodi may have re-parented kodi.bin under PID 1.
    for proc_name in ("cage", "kodi.bin", "kodi"):
        subprocess.run(
            ["pkill", "-TERM", "-u", "pitv", "-x", proc_name],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False,
        )

    # Native Linux Stremio is a system Flatpak but the running instance belongs
    # to pitv. "flatpak kill" is the supported targeted close path.
    if shutil.which("flatpak"):
        try:
            run_as_pitv(
                ["flatpak", "kill", "com.stremio.Stremio"], timeout=15
            )
        except Exception:
            pass

    # Give clients a short graceful window, then ensure stale fullscreen
    # surfaces cannot survive a launcher/session restart.
    time.sleep(0.6)
    for proc_name in ("cage", "kodi.bin", "kodi"):
        subprocess.run(
            ["pkill", "-KILL", "-u", "pitv", "-x", proc_name],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False,
        )

    # The Android container is not needed when no Android TV app is active.
    # Stopping it also releases Pi 4 GPU/RAM state after a crashed launcher.
    if shutil.which("waydroid"):
        subprocess.run(
            ["waydroid", "container", "stop"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=60,
            check=False,
        )

    for marker in (
        "pitv-launch.json",
        "pitv-waydroid-app-ready",
        "pitv-waydroid-runtime-ready",
    ):
        try:
            os.unlink(os.path.join(runtime, marker))
        except FileNotFoundError:
            pass
        except OSError:
            pass

    out("PiTV TV runtime vyčištěn")

elif action == "tv-input-enable":
    enabled = bool(payload.get("enabled", True))
    marker = "/var/lib/pitv/cec-disabled"
    os.makedirs(os.path.dirname(marker), exist_ok=True)

    if enabled:
        try:
            os.unlink(marker)
        except FileNotFoundError:
            pass
        p = subprocess.run(
            ["systemctl", "start", "pitv-inputd.service"],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            timeout=30,
            check=False,
        )
        if p.returncode != 0:
            out((p.stdout or "").strip() or "TV input službu nelze spustit", 3)
        out("HDMI-CEC TV input zapnut")
    else:
        with open(marker, "w", encoding="utf-8") as handle:
            handle.write("disabled\n")
        subprocess.run(
            ["systemctl", "stop", "pitv-inputd.service"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=30,
            check=False,
        )
        out("HDMI-CEC TV input vypnut")

