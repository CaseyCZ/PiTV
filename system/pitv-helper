WAYDROID_MEDIA = "/home/pitv/.local/share/waydroid/data/media/0/PiTV-Media"
KODI_APPLIANCE_SOURCE = "/etc/pitv/kodi-appliance.xml"
KODI_APPLIANCE_TARGET = "/usr/share/kodi/system/settings/appliance.xml"


def ensure_kodi_appliance_defaults():
    """Merge PiTV's Pi 4 DRM PRIME defaults into Kodi's appliance settings."""
    source = KODI_APPLIANCE_SOURCE
    target = KODI_APPLIANCE_TARGET
    if not os.path.isfile(source):
        raise RuntimeError("PiTV Kodi appliance konfigurace chybí")
    target_dir = os.path.dirname(target)
    if not os.path.isdir(target_dir):
        raise RuntimeError("Kodi system settings adresář neexistuje")

    desired = {
        "videoplayer.useprimedecoder": "true",
        "videoplayer.useprimedecoderforhw": "true",
    }

    if os.path.exists(target):
        try:
            tree = ET.parse(target)
            root = tree.getroot()
        except Exception as e:
            raise RuntimeError(f"Stávající Kodi appliance.xml nelze načíst: {e}")
        if root.tag != "settings":
            raise RuntimeError("Stávající Kodi appliance.xml nemá kořen <settings>")
    else:
        # Start from the PiTV file so the structure stays identical to the
        # documented Kodi appliance override format used by LibreELEC/CoreELEC.
        tree = ET.parse(source)
        root = tree.getroot()

    by_id = {
        node.get("id"): node
        for node in root.iter("setting")
        if node.get("id")
    }

    # Reuse/create player -> videoplayer -> group 3. Kodi merges appliance
    # definitions into the existing Linux setting definitions by ID.
    section = next(
        (x for x in root.findall("section") if x.get("id") == "player"), None
    )
    if section is None:
        section = ET.SubElement(root, "section", {"id": "player"})
    category = next(
        (x for x in section.findall("category") if x.get("id") == "videoplayer"),
        None,
    )
    if category is None:
        category = ET.SubElement(section, "category", {"id": "videoplayer"})
    group = next(
        (x for x in category.findall("group") if x.get("id") == "3"), None
    )
    if group is None:
        group = ET.SubElement(category, "group", {"id": "3"})

    changed = False
    for setting_id, value in desired.items():
        setting = by_id.get(setting_id)
        if setting is None:
            setting = ET.SubElement(group, "setting", {"id": setting_id})
            changed = True
        default = setting.find("default")
        if default is None:
            default = ET.SubElement(setting, "default")
            changed = True
        if (default.text or "").strip().lower() != value:
            default.text = value
            changed = True

    if not os.path.exists(target) or changed:
        fd, tmp = tempfile.mkstemp(
            prefix="appliance.xml-", suffix=".tmp", dir=target_dir
        )
        os.close(fd)
        try:
            tree.write(tmp, encoding="utf-8", xml_declaration=True)
            os.chmod(tmp, 0o644)
            os.replace(tmp, target)
        finally:
            if os.path.exists(tmp):
                os.unlink(tmp)
    return target


def ensure_waydroid_media_bridge():
    """Expose PiTV's persistent Media folder inside Android shared storage."""
    os.makedirs(MEDIA_HOST, mode=0o777, exist_ok=True)
    os.chmod(MEDIA_HOST, 0o777)
    os.makedirs(WAYDROID_MEDIA, mode=0o777, exist_ok=True)

    mounted = subprocess.run(
        ["mountpoint", "-q", WAYDROID_MEDIA],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    ).returncode == 0
    if not mounted:
        p = subprocess.run(
            ["mount", "--bind", MEDIA_HOST, WAYDROID_MEDIA],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            timeout=20,
            check=False,
        )
        if p.returncode != 0:
            raise RuntimeError((p.stdout or "").strip() or "bind mount PiTV Media selhal")

