def parse_android_top_component(text):
    """Return the Activity that is actually resumed on screen.

    Waydroid can expose multiple ACTIVITY blocks in `dumpsys activity top`.
    On the physical Pi 4 the first block may be Launcher3 even while a later
    SmartTube BrowseActivity block has `mResumed=true`. Treat explicit resumed
    markers as authoritative and use the first generic ACTIVITY only as a
    compatibility fallback for Android builds that omit those markers.
    """
    text = text or ""

    # Newer ActivityManager dumps often publish the resumed component directly.
    for pattern in (
        r"topResumedActivity=.*?\s([A-Za-z][A-Za-z0-9_.]+/[A-Za-z0-9_.$]+)",
        r"mResumedActivity:.*?\s([A-Za-z][A-Za-z0-9_.]+/[A-Za-z0-9_.$]+)",
    ):
        match = re.search(pattern, text)
        if match:
            return match.group(1)

    # `dumpsys activity top` may contain several full Activity blocks. Select
    # the block whose local Activity state says mResumed=true instead of blindly
    # accepting the first ACTIVITY line (which can be Android Home).
    activity_re = re.compile(
        r"(?m)^\s*ACTIVITY\s+([A-Za-z][A-Za-z0-9_.]+/[A-Za-z0-9_.$]+)"
    )
    activities = list(activity_re.finditer(text))
    for index, match in enumerate(activities):
        block_end = (
            activities[index + 1].start()
            if index + 1 < len(activities)
            else len(text)
        )
        block = text[match.end():block_end]
        if re.search(r"(?m)^\s*mResumed\s*=\s*true\b", block):
            return match.group(1)

    # Compatibility fallback for terse dumps containing a single ACTIVITY line.
    if activities:
        return activities[0].group(1)
    return ""


def parse_android_top_package(text):
    component = parse_android_top_component(text)
    if component:
        return component.split("/", 1)[0]
    return ""


def android_home_surface(top_package, top_component=""):
    if top_package in ANDROID_HOME_PACKAGES:
        return True
    component = str(top_component or "").lower()
    # AOSP/Lineage may expose its bootstrap Home as Settings/FallbackHome
    # until a dedicated launcher is provisioned. Physical Pi 4 Waydroid uses
    # exactly this surface.
    return component.endswith("/.fallbackhome") or component.endswith(".fallbackhome")


def resolve_android_launcher_component(text, package):
    """Extract one PackageManager-resolved component for the requested app."""
    package = str(package or "").strip()
    if not package:
        return ""
    for raw in reversed((text or "").splitlines()):
        line = raw.strip()
        if re.fullmatch(
            re.escape(package) + r"/[A-Za-z0-9_.$]+",
            line,
        ):
            return line
    return ""


def android_tv_session_active(top_package, target_running=False, top_ok=True,
                              top_component=""):
    """Return whether the viewer is still inside one Android TV app flow."""
    if top_ok and top_package:
        return not android_home_surface(top_package, top_component)
    if target_running:
        return True
    # A transient ActivityManager error is not evidence that the user left.
    return not top_ok


def android_app_launch_visible(target_package, top_package,
                               target_running=False, top_ok=True,
                               top_component=""):
    """Return whether a requested Android app has entered a visible app flow.

    A TV app can immediately delegate foreground to Android Settings,
    permission controller, account picker, splash/provisioning activity, etc.
    Requiring the exact target package to remain the top activity makes PiTV
    falsely retry an already successful launch.  Home is the only authoritative
    non-app surface; otherwise accept a delegated foreground while the target
    process exists.  If ActivityManager is transiently unavailable, a running
    target process is preferable to issuing a duplicate launch intent.
    """
    if top_ok and top_package:
        if top_package == target_package:
            return True
        if android_home_surface(top_package, top_component):
            return False
        return bool(target_running)
    return bool(target_running)


def out(msg, code=0):
    print(msg)
    raise SystemExit(code)

def waydroid_shell(args, timeout=30):
    """Run one Android shell command without Waydroid argparse eating flags.

    Waydroid 1.6.x parses option-looking tokens passed after `waydroid shell`
    as its own CLI arguments. Feeding the Android command over stdin bypasses
    that parser while preserving root shell access inside the container.
    """
    command = shlex.join([str(x) for x in args])
    return subprocess.run(
        ["waydroid", "shell"],
        input=command + "\n",
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        timeout=timeout,
        check=False,
    )


def require_waydroid_shell(args, timeout=30):
    p = waydroid_shell(args, timeout=timeout)
    text = (p.stdout or "").strip()
    if p.returncode != 0:
        out(text or f"Android shell chyba ({p.returncode})", p.returncode)
    return text


def run(args, timeout=600, stdin=None, env=None):
    args = list(args)
    # All APT actions launched from PiTV must coexist with Ubuntu's automatic
    # unattended-upgrades. Wait for the package-manager lock instead of failing
    # immediately with code 100 or deleting lock files.
    if args and os.path.basename(args[0]) == "apt-get":
        has_lock_timeout = any("DPkg::Lock::Timeout=" in str(x) for x in args)
        if not has_lock_timeout:
            args[1:1] = ["-o", "DPkg::Lock::Timeout=600"]
        # The process timeout must be longer than APT's own 600 s lock wait,
        # otherwise PiTV would abort while apt-get is still correctly waiting
        # for unattended-upgrades. Keep another five minutes for the actual
        # update/install/remove work after the lock becomes available.
        timeout = max(timeout, 900)
    p = subprocess.run(args, input=stdin, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                       text=True, timeout=timeout, check=False, env=env)
    text = (p.stdout or "").strip()
    if p.returncode != 0:
        out(text or f"Chyba ({p.returncode})", p.returncode)
    return text


