elif action == "waydroid-container-start":
    if shutil.which("waydroid") is None:
        out("Waydroid není nainstalovaný", 2)
    status = subprocess.run(
        ["waydroid", "status"],
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        text=True, timeout=10, check=False,
    )
    if not re.search(r"^Container:\s*RUNNING\s*$", status.stdout or "", re.M | re.I):
        run(["waydroid", "container", "start"], timeout=60)
    try:
        ensure_waydroid_media_bridge()
    except Exception as e:
        out(f"Waydroid běží, ale sdílená složka PiTV Media se nepřipojila: {e}", 3)
    out("Waydroid container spuštěn · PiTV Media připojeno")

elif action == "waydroid-ready":
    if shutil.which("waydroid") is None:
        out("Waydroid není nainstalovaný", 2)
    status = subprocess.run(
        ["waydroid", "status"],
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        text=True, timeout=10, check=False,
    )
    if not re.search(r"^Session:\s*RUNNING\s*$", status.stdout or "", re.M | re.I):
        out("Waydroid session ještě neběží", 4)
    boot = subprocess.run(
        ["waydroid", "shell", "getprop", "sys.boot_completed"],
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        text=True, timeout=10, check=False,
    )
    if boot.returncode == 0 and (boot.stdout or "").strip().endswith("1"):
        out("ready")
    out("Android framework ještě není připravený", 4)

elif action == "waydroid-keyevent":
    # Upstream Waydroid requires "waydroid shell" to run as root. PiTV owns
    # the TV CEC adapter and relays only this small allowlist into Android.
    code = str(payload.get("code", "")).strip()
    allowed = {
        "4",   # KEYCODE_BACK
        "19",  # KEYCODE_DPAD_UP
        "20",  # KEYCODE_DPAD_DOWN
        "21",  # KEYCODE_DPAD_LEFT
        "22",  # KEYCODE_DPAD_RIGHT
        "23",  # KEYCODE_DPAD_CENTER
        "85",  # KEYCODE_MEDIA_PLAY_PAUSE
        "127", # KEYCODE_MEDIA_PAUSE (pause-only for launcher multitasking)
    }
    if code not in allowed:
        out("Nepovolená Android klávesa", 2)
    if shutil.which("waydroid") is None:
        out("Waydroid není nainstalovaný", 2)
    run(["waydroid", "shell", "input", "keyevent", code], timeout=10)
    out("keyevent sent")

elif action == "waydroid-package-installed":
    package = str(payload.get("package", "")).strip()
    if not re.fullmatch(r"[A-Za-z][A-Za-z0-9_]*(?:\.[A-Za-z0-9_]+)+", package):
        out("Neplatný Android package ID", 2)
    p = subprocess.run(
        ["waydroid", "shell", "pm", "path", package],
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        text=True, timeout=15, check=False,
    )
    installed = (
        p.returncode == 0
        and any(line.strip().startswith("package:")
                for line in (p.stdout or "").splitlines())
    )
    if installed:
        out("installed")
    out("missing", 4)

elif action == "waydroid-packages":
    p = subprocess.run(
        ["waydroid", "shell", "pm", "list", "packages"],
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        text=True, timeout=20, check=False,
    )
    if p.returncode != 0:
        out((p.stdout or "").strip() or "Android package manager není dostupný", 4)
    packages = []
    for line in (p.stdout or "").splitlines():
        line = line.strip()
        if not line.startswith("package:"):
            continue
        package = line.split(":", 1)[1].strip()
        if re.fullmatch(r"[A-Za-z][A-Za-z0-9_]*(?:\.[A-Za-z0-9_]+)+", package):
            packages.append(package)
    print("\n".join(sorted(set(packages))))
    raise SystemExit(0)

elif action == "waydroid-app-stop":
    package = str(payload.get("package", "")).strip()
    if not re.fullmatch(r"[A-Za-z][A-Za-z0-9_]*(?:\.[A-Za-z0-9_]+)+", package):
