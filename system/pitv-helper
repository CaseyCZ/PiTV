    print(f"hevc_decoder={'c2.ffmpeg.hevc.decoder' if hevc_decoder else 'missing'}")
    print(f"avc_codec2_hal={avc_service_value or 'missing'}")
    print(f"hevc_codec2_hal={hevc_service_value or 'missing'}")
    print(f"hevc_v4l2_request={hevc_hw_value or 'missing'}")
