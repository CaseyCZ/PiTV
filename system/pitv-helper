elif action == "waydroid-container-start":
    if shutil.which("waydroid") is None:
        out("Waydroid není nainstalovaný", 2)

    # Official Waydroid packages provide a persistent root D-Bus container
    # manager. "waydroid container start" is that daemon itself and is not a
    # one-shot request to boot Android. Keep the manager under systemd and let
    # the unprivileged "waydroid session start" request the actual LXC session.
    p = subprocess.run(
        ["systemctl", "start", "waydroid-container.service"],
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        text=True, timeout=30, check=False,
    )
    if p.returncode != 0:
        out((p.stdout or "").strip() or "Waydroid container manager nelze spustit", 3)
    active = subprocess.run(
        ["systemctl", "is-active", "--quiet", "waydroid-container.service"],
