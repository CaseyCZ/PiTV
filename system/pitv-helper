                top_package, top_ok=True, top_component=top_component):
            out(f"active:{top_package}")
        out(f"Android Home je aktivní: {top_package}", 4)

    # ActivityManager can be briefly unavailable while Android is switching
    # activities. In that case fall back to the target process and prefer not
    # to eject the user because of one transient dumpsys failure.
    p = waydroid_shell(["pidof", package], timeout=5)
    target_running = p.returncode == 0 and bool((p.stdout or "").strip())
    if android_tv_session_active(
            top_package, target_running=target_running,
            top_ok=(top.returncode == 0), top_component=top_component):
        out("active:fallback")

    out("Android TV session už není aktivní", 4)

