    target_dir = "/etc/pitv/store"
    os.makedirs(target_dir, exist_ok=True)
    catalogs = [
        ("catalog.json", "apps"),
        ("server_catalog.json", "services"),
    ]
    try:
        for filename, list_key in catalogs:
            url = f"https://raw.githubusercontent.com/CaseyCZ/PiTV/Master/store/{filename}"
            req = urllib.request.Request(url, headers={"User-Agent": "PiTV-Updater/1.3"})
            with urllib.request.urlopen(req, timeout=30) as r:
                data = r.read()
            parsed = json.loads(data.decode("utf-8"))
            if not isinstance(parsed, dict) or not isinstance(parsed.get(list_key), list):
                out(f"Stažený katalog {filename} není platný", 2)
            target = os.path.join(target_dir, filename)
            fd, tmp = tempfile.mkstemp(prefix=filename + "-", suffix=".tmp", dir=target_dir)
            try:
                with os.fdopen(fd, "wb") as h:
                    h.write(data)
                os.chmod(tmp, 0o644)
                os.replace(tmp, target)
            finally:
                if os.path.exists(tmp):
                    os.unlink(tmp)
        out("PiTV Store a Server Store katalog aktualizovány")
    except Exception as e:
        out(f"Aktualizace Store katalogů selhala: {e}", 2)

