        out("Neplatný Android package ID", 2)

    sections = []
    def capture(title, args, timeout=15):
        try:
            if list(args[:2]) == ["waydroid", "shell"]:
                p = waydroid_shell(args[2:], timeout=timeout)
            else:
                p = subprocess.run(
                    args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                    text=True, timeout=timeout, check=False,
                )
            body = (p.stdout or "").strip()
            sections.append(f"=== {title} rc={p.returncode} ===\n{body}")
        except Exception as e:
            sections.append(f"=== {title} ===\n{type(e).__name__}: {e}")

    capture("STATUS", ["waydroid", "status"], 10)
    capture("BOOT", ["waydroid", "shell", "getprop", "sys.boot_completed"], 10)
    capture("USER0", ["waydroid", "shell", "am", "get-started-user-state", "0"], 10)
    capture("ACTIVE_APPS", ["waydroid", "shell", "getprop", "waydroid.active_apps"], 10)
    capture("MULTI_WINDOWS", ["waydroid", "shell", "getprop", "persist.waydroid.multi_windows"], 10)
    capture("TOP", ["waydroid", "shell", "dumpsys", "activity", "top"], 15)
    if package:
        capture("PACKAGE", ["waydroid", "shell", "pm", "path", package], 15)
        capture("PID", ["waydroid", "shell", "pidof", package], 10)
    capture("LOGCAT", ["waydroid", "shell", "logcat", "-d", "-t", "120"], 20)
    print("\n".join(sections)[-24000:])
    raise SystemExit(0)

