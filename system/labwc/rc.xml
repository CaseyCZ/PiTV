<?xml version="1.0"?>
<labwc_config>
  <core>
    <decoration>client</decoration>
    <gap>0</gap>
  </core>
  <theme>
    <cornerRadius>0</cornerRadius>
    <keepBorder>no</keepBorder>
    <maximizedDecoration>none</maximizedDecoration>
  </theme>

  <!--
    PiTV uses workspaces as TV-style multitasking slots. The launcher always
    lives on PiTV. Built-in media runtimes get their own workspace so they can
    remain alive/paused while the user returns to the launcher.
  -->
  <desktops>
    <popupTime>0</popupTime>
    <initial>PiTV</initial>
    <names>
      <name>PiTV</name>
      <name>Kodi</name>
      <name>Stremio</name>
      <name>Android</name>
      <name>Apps</name>
    </names>
  </desktops>

  <keyboard>
    <keybind key="W-Home"><action name="Execute" command="wtype -k Home" /></keybind>

    <!-- Private PiTV compositor controls. PiTV sends these with wtype. -->
    <keybind key="W-F8"><action name="GoToDesktop" to="Apps" /></keybind>
    <keybind key="W-F9"><action name="GoToDesktop" to="PiTV" /></keybind>
    <keybind key="W-F10"><action name="GoToDesktop" to="Kodi" /></keybind>
    <keybind key="W-F11"><action name="GoToDesktop" to="Stremio" /></keybind>
    <keybind key="W-F12"><action name="GoToDesktop" to="Android" /></keybind>
  </keyboard>

  <windowRules>
    <!--
      PiTV must behave like an appliance surface, not a desktop window. A
      maximized rule is deliberately kept in addition to SDL fullscreen so a
      HDMI disconnect/reconnect cannot leave the launcher decorated, offset or
      at the temporary fallback output size.
    -->
    <windowRule title="PiTV *">
      <action name="SendToDesktop" to="PiTV" follow="no" />
      <action name="Maximize" />
    </windowRule>

    <!-- Kodi also hosts Plex/PM4K, so both intentionally share one slot. -->
    <windowRule identifier="Kodi*">
      <action name="SendToDesktop" to="Kodi" follow="yes" />
      <action name="Maximize" />
    </windowRule>

    <!-- Flatpak/Electron builds have used both identifiers. -->
    <windowRule identifier="com.stremio.Stremio">
      <action name="SendToDesktop" to="Stremio" follow="yes" />
      <action name="Maximize" />
    </windowRule>
    <windowRule identifier="Stremio*">
      <action name="SendToDesktop" to="Stremio" follow="yes" />
      <action name="Maximize" />
    </windowRule>

    <!--
      Nested Cage/wlroots is the one Android TV surface. Do not follow it when
      it maps: ordinary Android launches boot invisibly on the Android
      workspace and PiTV switches there only after the requested app is ready.
    -->
    <windowRule identifier="wlroots">
      <action name="SendToDesktop" to="Android" follow="no" />
      <action name="Maximize" />
    </windowRule>
  </windowRules>
</labwc_config>
