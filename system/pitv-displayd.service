[Unit]
Description=PiTV HDMI/EDID output recovery
After=systemd-udevd.service
Before=pitv-shell.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/libexec/pitv-displayd
Restart=always
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/run/pitv
TimeoutStopSec=5

[Install]
WantedBy=pitv.target
