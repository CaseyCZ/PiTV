#!/usr/bin/env python3
import os
import shutil
import subprocess
import tempfile
import urllib.request
import zipfile
from pathlib import Path

ARCHIVE_URL = "https://codeload.github.com/CaseyCZ/PiTV/zip/refs/heads/Master"


def fail(message):
    print(message)
    raise SystemExit(1)


if os.geteuid() != 0:
    fail("PiTV self updater musí běžet jako root")

print("PiTV: kontroluji a stahuji aktuální Master…", flush=True)

with tempfile.TemporaryDirectory(prefix="pitv-update-") as td:
    td = Path(td)
    archive = td / "pitv.zip"
    req = urllib.request.Request(ARCHIVE_URL, headers={"User-Agent": "PiTV-Updater/1.3"})
    try:
        with urllib.request.urlopen(req, timeout=60) as src, open(archive, "wb") as out:
            shutil.copyfileobj(src, out)
    except Exception as e:
        fail(f"Stažení PiTV selhalo: {e}")

    print("PiTV: staženo, rozbaluji aktualizaci…", flush=True)
    try:
        with zipfile.ZipFile(archive) as z:
            z.extractall(td / "src")
    except Exception as e:
        fail(f"Rozbalení PiTV selhalo: {e}")

    candidates = list((td / "src").glob("*/install.sh"))
    if not candidates:
        fail("V balíčku nebyl nalezen PiTV/install.sh")

    install = candidates[0]
    source = install.parent
    try:
        print("PiTV: spouštím instalaci…", flush=True)
        p = subprocess.run(
            ["bash", str(install)],
            cwd=str(source),
            text=True,
            timeout=1800,
            check=False,
        )
    except subprocess.TimeoutExpired:
        fail("Aktualizace PiTV vypršela")

    if p.returncode != 0:
        fail(f"Aktualizace PiTV selhala (kód {p.returncode})")

    print("PiTV aktualizováno z GitHubu")
