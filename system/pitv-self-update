#!/usr/bin/env python3
import json
import os
import pwd
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.parse
import urllib.request
import zipfile
from pathlib import Path

COMMIT_API = "https://api.github.com/repos/CaseyCZ/PiTV/commits/Master"
COMPARE_API = "https://api.github.com/repos/CaseyCZ/PiTV/compare/{base}...{head}"
RAW_BASE = "https://raw.githubusercontent.com/CaseyCZ/PiTV/{sha}/{path}"
USER_AGENT = "PiTV-Updater/1.5.0"
STATE_FILE = Path("/var/lib/pitv/update-state.json")
MAX_ARCHIVE_BYTES = 50 * 1024 * 1024
MAX_EXTRACTED_BYTES = 250 * 1024 * 1024
MAX_DELTA_FILE_BYTES = 20 * 1024 * 1024
MAX_DELTA_TOTAL_BYTES = 60 * 1024 * 1024


def progress(percent, message):
    print(f"PiTV [{percent:3d}%] {message}", flush=True)


def fail(message):
    print(f"PiTV [CHYBA] {message}", flush=True)
    raise SystemExit(1)


def request(url, timeout=60):
    return urllib.request.urlopen(
        urllib.request.Request(
            url,
            headers={
                "User-Agent": USER_AGENT,
                "Accept": "application/vnd.github+json",
            },
        ),
        timeout=timeout,
    )


def resolve_master_sha():
    try:
        with request(COMMIT_API, timeout=30) as src:
            data = json.load(src)
    except Exception as e:
        fail(f"Nelze zjistit aktuální PiTV commit: {e}")
    sha = str(data.get("sha", "")).strip().lower()
    if not re.fullmatch(r"[0-9a-f]{40}", sha):
        fail("GitHub vrátil neplatný commit SHA")
    return sha


def validate_zip(z):
    total = 0
    for info in z.infolist():
        name = info.filename.replace("\\", "/")
        parts = Path(name).parts
        if not name or name.startswith("/") or ".." in parts:
            fail(f"Nebezpečná cesta v aktualizaci: {name!r}")
        total += max(0, int(info.file_size))
        if total > MAX_EXTRACTED_BYTES:
            fail("Rozbalená aktualizace je neočekávaně velká")


SYSTEM_BIN = {
    "system/pitv-session": "/usr/local/bin/pitv-session",
    "system/pitv-session-run": "/usr/local/bin/pitv-session-run",
    "system/pitv-launcher-run": "/usr/local/bin/pitv-launcher-run",
    "system/pitv-waydroid-launch": "/usr/local/bin/pitv-waydroid-launch",
    "system/pitv-kodi-launch": "/usr/local/bin/pitv-kodi-launch",
    "system/pitv-kodi-addon": "/usr/local/bin/pitv-kodi-addon",
}
LIBEXEC_BIN = {
    "system/pitv-helper": "/usr/local/libexec/pitv-helper",
    "system/pitv-self-update": "/usr/local/libexec/pitv-self-update",
    "system/pitv-android-warm": "/usr/local/libexec/pitv-android-warm",
    "system/pitv-inputd": "/usr/local/libexec/pitv-inputd",
    "system/pitv-cec-control": "/usr/local/libexec/pitv-cec-control",
    "system/pitv-global-action": "/usr/local/libexec/pitv-global-action",
    "system/pitv-displayd": "/usr/local/libexec/pitv-displayd",
    "system/pitv-waydroid-device-patch": "/usr/local/libexec/pitv-waydroid-device-patch",
}
SYSTEMD_FILES = {
    "system/pitv.target": "/etc/systemd/system/pitv.target",
    "system/pitv-shell.service": "/etc/systemd/system/pitv-shell.service",
    "system/pitv-android-warm.service": "/etc/systemd/system/pitv-android-warm.service",
    "system/pitv-inputd.service": "/etc/systemd/system/pitv-inputd.service",
    "system/pitv-displayd.service": "/etc/systemd/system/pitv-displayd.service",
    "system/waydroid-container-pitv.conf": "/etc/systemd/system/waydroid-container.service.d/pitv-rpi4-media.conf",
}


def installed_sha():
    try:
        data = json.loads(STATE_FILE.read_text(encoding="utf-8"))
    except Exception:
        return ""
    sha = str(data.get("sha", "")).strip().lower()
    return sha if re.fullmatch(r"[0-9a-f]{40}", sha) else ""


def save_installed_sha(sha):
    if not re.fullmatch(r"[0-9a-f]{40}", sha):
        raise ValueError("invalid installed SHA")
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE_FILE.with_name(f".{STATE_FILE.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps({"sha": sha}, separators=(",", ":")) + "\n",
                   encoding="utf-8")
    os.chmod(tmp, 0o644)
    os.replace(tmp, STATE_FILE)


def delta_target(path):
    """Map one repository runtime file to its installed path and restart class.

    Return None for repository-only files. Raise ValueError for runtime-sensitive
    files that are intentionally not safe for an incremental update.
    """
    path = str(path or "").replace("\\", "/").lstrip("/")
    if not path or ".." in Path(path).parts:
        raise ValueError("invalid delta path")

    if path == "install.sh":
        raise ValueError("installer changed")

    if path.startswith("pitv/"):
        rel = path[len("pitv/"):]
        if not rel:
            raise ValueError("invalid PiTV runtime path")
        mode = 0o755 if rel == "pitv.py" else 0o644
        return Path("/opt/pitv/pitv") / rel, mode, None, {"shell"}

    if path == "config/config.json":
        return Path("/etc/pitv/config.json"), 0o644, None, {"shell"}
    if path.startswith("config/apps.d/"):
        rel = path[len("config/apps.d/"):]
        if not rel:
            raise ValueError("invalid launcher path")
        return Path("/etc/pitv/apps.d") / rel, 0o644, None, {"shell"}

    if path == "store/catalog.json":
        return Path("/etc/pitv/store/catalog.json"), 0o644, None, {"shell"}
    if path == "store/server_catalog.json":
        return Path("/etc/pitv/store/server_catalog.json"), 0o644, None, {"shell"}

    if path == "system/kodi/appliance.xml":
        return Path("/etc/pitv/kodi-appliance.xml"), 0o644, None, {"kodi-defaults"}

    if path.startswith("system/labwc/"):
        rel = path[len("system/labwc/"):]
        if not rel:
            raise ValueError("invalid labwc path")
        return Path("/home/pitv/.config/labwc") / rel, 0o644, "pitv", {"shell"}

    if path in SYSTEM_BIN:
        restarts = set()
        if path in {
            "system/pitv-session",
            "system/pitv-session-run",
            "system/pitv-launcher-run",
        }:
            restarts.add("shell")
        elif path == "system/pitv-waydroid-launch":
            restarts.add("android")
        return Path(SYSTEM_BIN[path]), 0o755, None, restarts

    if path in LIBEXEC_BIN:
        restarts = set()
        if path == "system/pitv-android-warm":
            restarts.add("android")
        elif path == "system/pitv-inputd":
            restarts.add("inputd")
        elif path == "system/pitv-displayd":
            restarts.add("displayd")
        # helper/self-update/CEC output/global action are short-lived tools:
        # replacing them atomically is enough for the next invocation.
        return Path(LIBEXEC_BIN[path]), 0o755, None, restarts

    if path in SYSTEMD_FILES:
        restarts = {"daemon-reload"}
        if path == "system/pitv-shell.service":
            restarts.add("shell")
        elif path == "system/pitv-android-warm.service":
            restarts.add("android")
        elif path == "system/pitv-inputd.service":
            restarts.add("inputd")
        elif path == "system/pitv-displayd.service":
            restarts.add("displayd")
        return Path(SYSTEMD_FILES[path]), 0o644, None, restarts

    if path == "scripts/install-waydroid.sh":
        return Path("/usr/local/libexec/pitv-install-waydroid"), 0o755, None, set()

    # Android image build/test helpers are repository tooling, not files copied
    # into an installed PiTV appliance. Their changes must not force a full
    # appliance reinstall during an ordinary self-update.
    if path in {
        "scripts/build-waydroid-rpi4-v4l2.sh",
        "scripts/install-waydroid-rpi4-v4l2-image.sh",
    }:
        return None

    # These trees affect the installed appliance. Unknown files inside them
    # deliberately force the safe full installer instead of being guessed.
    if path.startswith(("pitv/", "config/", "store/", "system/", "scripts/")):
        raise ValueError(f"unknown runtime path: {path}")

    # Docs, CI, release notes, Windows installer and repository metadata do not
    # change an already-installed PiTV appliance.
    return None


def fetch_compare(base, head):
    url = COMPARE_API.format(base=base, head=head)
    with request(url, timeout=30) as src:
        data = json.load(src)
    status = str(data.get("status", ""))
    if status not in ("ahead", "identical"):
        raise RuntimeError(f"compare status {status or 'unknown'}")
    files = list(data.get("files") or [])
    # GitHub compare caps the file list. Never risk a partial delta.
    if len(files) >= 300:
        raise RuntimeError("too many changed files for delta update")
    return files


def build_delta_plan(files):
    plan = []
    restart_classes = set()
    for item in files:
        status = str(item.get("status", ""))
        path = str(item.get("filename", ""))
        if status == "renamed":
            raise ValueError(f"renamed runtime file: {path}")
        mapped = delta_target(path)
        if mapped is None:
            continue
        target, mode, owner, restarts = mapped
        if status not in ("added", "modified", "removed", "changed"):
            raise ValueError(f"unsupported delta status {status}: {path}")
        plan.append({
            "repo_path": path,
            "status": status,
            "target": target,
            "mode": mode,
            "owner": owner,
        })
        restart_classes.update(restarts)
    return plan, restart_classes


def download_delta(sha, plan, staging):
    total = 0
    for index, item in enumerate(plan, 1):
        if item["status"] == "removed":
            continue
        path = item["repo_path"]
        url = RAW_BASE.format(
            sha=sha,
            path=urllib.parse.quote(path, safe="/"),
        )
        dest = staging / f"{index:04d}.bin"
        with request(url, timeout=45) as src, dest.open("wb") as out:
            length = int(src.headers.get("Content-Length", "0") or 0)
            if length and length > MAX_DELTA_FILE_BYTES:
                raise RuntimeError(f"delta file too large: {path}")
            copied = 0
            while True:
                chunk = src.read(256 * 1024)
                if not chunk:
                    break
                copied += len(chunk)
                total += len(chunk)
                if copied > MAX_DELTA_FILE_BYTES or total > MAX_DELTA_TOTAL_BYTES:
                    raise RuntimeError("delta update exceeded size limit")
                out.write(chunk)
        item["staged"] = dest


def atomic_install_file(source, target, mode, owner=None):
    target.parent.mkdir(parents=True, exist_ok=True)
    tmp = target.parent / f".{target.name}.pitv-update-{os.getpid()}"
    shutil.copyfile(source, tmp)
    os.chmod(tmp, mode)
    if owner:
        account = pwd.getpwnam(owner)
        os.chown(tmp, account.pw_uid, account.pw_gid)
    os.replace(tmp, target)


def apply_delta(plan, restart_classes):
    for item in plan:
        target = item["target"]
        if item["status"] == "removed":
            try:
                target.unlink()
            except FileNotFoundError:
                pass
            continue
        atomic_install_file(
            item["staged"], target, item["mode"], item["owner"]
        )

    if "daemon-reload" in restart_classes:
        subprocess.run(["systemctl", "daemon-reload"], check=True)

    if "kodi-defaults" in restart_classes and shutil.which("kodi"):
        subprocess.run(
            ["/bin/sh", "-c",
             "printf '{}' | /usr/local/libexec/pitv-helper kodi-appliance-defaults"],
            check=False,
        )


def schedule_targeted_restarts(restart_classes):
    units = []
    if "inputd" in restart_classes:
        units.append("pitv-inputd.service")
    if "displayd" in restart_classes:
        units.append("pitv-displayd.service")
    # A shell restart propagates to pitv-android-warm through PartOf=.
    if "android" in restart_classes and "shell" not in restart_classes:
        units.append("pitv-android-warm.service")
    if "shell" in restart_classes:
        units.append("pitv-shell.service")
    if not units:
        return []

    commands = [
        f"/usr/bin/systemctl try-restart {unit}"
        for unit in units
    ]
    command = " ; ".join(commands)
    subprocess.run(
        [
            "systemd-run", "--quiet", "--collect",
            f"--unit=pitv-delta-restart-{os.getpid()}",
            "--on-active=1s",
            "/bin/sh", "-c", command,
        ],
        check=False,
    )
    return units


def try_delta_update(base, head):
    progress(15, f"Porovnávám {base[:8]} → {head[:8]}…")
    try:
        files = fetch_compare(base, head)
        plan, restart_classes = build_delta_plan(files)
    except Exception as e:
        print(f"PiTV [ ... ] Rychlá aktualizace není bezpečná: {e}", flush=True)
        return False

    if not plan:
        save_installed_sha(head)
        progress(100, f"Aktuální revize {head[:12]} (bez runtime změn).")
        return True

    progress(30, f"Stahuji jen {len(plan)} změněných runtime souborů…")
    try:
        with tempfile.TemporaryDirectory(prefix="pitv-delta-") as td_raw:
            staging = Path(td_raw)
            download_delta(head, plan, staging)
            progress(70, "Instaluji změněné soubory…")
            apply_delta(plan, restart_classes)
    except Exception as e:
        print(f"PiTV [ ... ] Delta selhala, přecházím na plnou instalaci: {e}",
              flush=True)
        return False

    save_installed_sha(head)
    units = schedule_targeted_restarts(restart_classes)
    if units:
        progress(95, "Restartuji jen: " + ", ".join(units))
    else:
        progress(95, "Restart není potřeba.")
    progress(100, f"Rychle aktualizováno na {head[:12]}")
    return True


def updater_self_test():
    target = delta_target("pitv/pitv.py")
    assert str(target[0]) == "/opt/pitv/pitv/pitv.py"
    assert "shell" in target[3]
    target = delta_target("system/pitv-helper")
    assert str(target[0]) == "/usr/local/libexec/pitv-helper"
    assert not target[3]
    target = delta_target("system/pitv-inputd")
    assert target[3] == {"inputd"}
    target = delta_target("system/pitv-waydroid-launch")
    assert target[3] == {"android"}
    target = delta_target("system/pitv-shell.service")
    assert target[3] == {"daemon-reload", "shell"}
    target = delta_target("system/pitv-waydroid-device-patch")
    assert str(target[0]) == "/usr/local/libexec/pitv-waydroid-device-patch"
    target = delta_target("system/waydroid-container-pitv.conf")
    assert str(target[0]).endswith("waydroid-container.service.d/pitv-rpi4-media.conf")
    assert target[3] == {"daemon-reload"}
    assert delta_target("scripts/build-waydroid-rpi4-v4l2.sh") is None
    assert delta_target("scripts/install-waydroid-rpi4-v4l2-image.sh") is None
    plan, restarts = build_delta_plan([
        {"filename": "system/pitv-helper", "status": "modified"},
        {"filename": "README.md", "status": "modified"},
    ])
    assert len(plan) == 1 and not restarts
    try:
        delta_target("install.sh")
    except ValueError:
        pass
    else:
        raise AssertionError("install.sh must force full update")
    print("PiTV incremental updater self-test OK")


if "--self-test" in sys.argv:
    updater_self_test()
    raise SystemExit(0)

if os.geteuid() != 0:
    fail("PiTV self updater musí běžet jako root")

progress(5, "Kontroluji novou verzi…")
sha = resolve_master_sha()
base_sha = installed_sha()

if base_sha == sha:
    progress(100, f"PiTV už je aktuální ({sha[:12]}).")
    raise SystemExit(0)

if base_sha and try_delta_update(base_sha, sha):
    raise SystemExit(0)

if not base_sha:
    print("PiTV [ ... ] První update ukládá výchozí revizi; používám plnou instalaci.",
          flush=True)

archive_url = f"https://codeload.github.com/CaseyCZ/PiTV/zip/{sha}"
progress(10, f"Stahuji celý commit {sha[:12]}…")

with tempfile.TemporaryDirectory(prefix="pitv-update-") as td_raw:
    td = Path(td_raw)
    archive = td / "pitv.zip"
    try:
        with request(archive_url, timeout=60) as src, archive.open("wb") as out:
            length = int(src.headers.get("Content-Length", "0") or 0)
            if length and length > MAX_ARCHIVE_BYTES:
                fail("Aktualizační archiv je neočekávaně velký")
            copied = 0
            while True:
                chunk = src.read(1024 * 256)
                if not chunk:
                    break
                copied += len(chunk)
                if copied > MAX_ARCHIVE_BYTES:
                    fail("Aktualizační archiv překročil bezpečný limit")
                out.write(chunk)
                if length:
                    pct = 10 + min(35, int(copied * 35 / length))
                    print(f"\rPiTV [{pct:3d}%] Stahování {copied / 1048576:.1f}/{length / 1048576:.1f} MiB", end="", flush=True)
            if length:
                print(flush=True)
    except SystemExit:
        raise
    except Exception as e:
        fail(f"Stažení PiTV selhalo: {e}")

    progress(50, "Staženo. Kontroluji a rozbaluji aktualizaci…")
    try:
        with zipfile.ZipFile(archive) as z:
            validate_zip(z)
            z.extractall(td / "src")
    except SystemExit:
        raise
    except Exception as e:
        fail(f"Rozbalení PiTV selhalo: {e}")

    candidates = list((td / "src").glob("*/install.sh"))
    if len(candidates) != 1:
        fail("V balíčku nebyl nalezen jednoznačný PiTV/install.sh")

    install = candidates[0]
    source = install.parent
    progress(60, "Balíček je v pořádku.")
    progress(65, "Spouštím instalaci…")
    env = os.environ.copy()
    env["DEBIAN_FRONTEND"] = "noninteractive"
    # install.sh also uses this value. Keep the updater explicit so old
    # PiTV builds downloading a new installer receive the same safe wait.
    env["APT_LOCK_TIMEOUT"] = "600"
    try:
        proc = subprocess.Popen(
            ["bash", str(install)],
            cwd=str(source),
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
            env=env,
        )
    except OSError as e:
        fail(f"Instalátor PiTV nelze spustit: {e}")

    captured = []
    try:
        assert proc.stdout is not None
        for raw_line in proc.stdout:
            line = raw_line.rstrip()
            if not line:
                continue
            captured.append(line)
            m = re.match(r"^PITV_PROGRESS\s+(\d+)\s+(.+)$", line)
            if m:
                pct = max(65, min(95, int(m.group(1))))
                progress(pct, m.group(2))
            else:
                print(f"PiTV [ ... ] {line}", flush=True)
        returncode = proc.wait(timeout=1800)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait()
        fail("Aktualizace PiTV vypršela")

    p = subprocess.CompletedProcess(proc.args, returncode, "\n".join(captured), None)
    if p.returncode != 0:
        raw = (p.stdout or "").strip()
        lines = [line.strip() for line in raw.splitlines() if line.strip()]
        lock_error = any(
            token in raw.lower()
            for token in (
                "could not get lock",
                "unable to acquire the dpkg frontend lock",
                "is another process using it",
            )
        )
        if lock_error:
            fail(
                "APT je stále zaneprázdněné systémovou aktualizací. "
                "PiTV na zámek čekalo 10 minut; zkus aktualizaci znovu později."
            )
        detail = " | ".join(lines[-4:])[-700:] if lines else ""
        fail(
            f"Aktualizace PiTV selhala (kód {p.returncode})"
            + (f": {detail}" if detail else "")
        )

    progress(95, "Instalace dokončena.")
    save_installed_sha(sha)
    # Restart the supervised TV shell only after this updater has returned.
    # A transient root unit survives GUI/SSH caller teardown and avoids the old
    # getty restart path, which is intentionally masked in PiTV 1.5.
    if subprocess.run(
        ["systemctl", "is-active", "--quiet", "pitv-shell.service"],
        check=False,
    ).returncode == 0:
        subprocess.run(
            [
                "systemd-run", "--quiet", "--collect",
                f"--unit=pitv-update-restart-{os.getpid()}",
                "--on-active=2s",
                "/usr/bin/systemctl", "restart", "pitv-shell.service",
            ],
            check=False,
        )
        progress(98, "Restart PiTV session naplánován…")
    progress(100, f"Aktualizováno na {sha[:12]}")
