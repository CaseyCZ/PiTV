#!/usr/bin/env bash
set -euo pipefail

if [ "$(id -un)" != "pitv" ]; then
  echo "PiTV TV session musí běžet jako uživatel pitv." >&2
  exit 2
fi

export HOME=/home/pitv
export USER=pitv
export LOGNAME=pitv
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=labwc
export SDL_VIDEODRIVER=wayland

# Never inherit an SSH/admin runtime. The TV stack has one canonical user
# runtime managed by logind/systemd --user.
RUNTIME="/run/user/$(id -u)"
export XDG_RUNTIME_DIR="$RUNTIME"
export PULSE_RUNTIME_PATH="$RUNTIME/pulse"
export DBUS_SESSION_BUS_ADDRESS="unix:path=$RUNTIME/bus"

if [ ! -d "$RUNTIME" ]; then
  echo "PiTV runtime $RUNTIME neexistuje; logind session není připravená." >&2
  exit 3
fi

# Use the standard systemd user bus. Do NOT create a second private
# dbus-run-session: labwc, PipeWire, WirePlumber, portals and TV apps must see
# the same pitv session.
systemctl --user start dbus.socket pipewire.socket pipewire-pulse.socket wireplumber.service >/dev/null 2>&1 || true

for _ in $(seq 1 50); do
  [ -S "$RUNTIME/bus" ] && [ -S "$RUNTIME/pulse/native" ] && break
  sleep 0.1
done

[ -S "$RUNTIME/bus" ] || { echo "PiTV user D-Bus není připravený." >&2; exit 4; }
[ -S "$RUNTIME/pulse/native" ] || { echo "PiTV PipeWire/Pulse není připravený." >&2; exit 5; }

exec labwc
