#!/usr/bin/env bash
set -euo pipefail

if [ "$(id -un)" != "pitv" ]; then
  echo "PiTV TV session musí běžet jako uživatel pitv." >&2
  exit 2
fi

export HOME=/home/pitv
export USER=pitv
export LOGNAME=pitv
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=labwc
export SDL_VIDEODRIVER=wayland

# One canonical runtime for the whole appliance session. The pitv account has
# linger enabled by the installer so the user manager, D-Bus and PipeWire are
# stable across TV-shell restarts just like system services are in LibreELEC.
RUNTIME="/run/user/$(id -u)"
export XDG_RUNTIME_DIR="$RUNTIME"
export PULSE_RUNTIME_PATH="$RUNTIME/pulse"
export DBUS_SESSION_BUS_ADDRESS="unix:path=$RUNTIME/bus"

LABWC_PID=""
LAUNCHER_PID=""
STOPPING=0

runtime_cleanup() {
  if [ -x /usr/local/libexec/pitv-helper ]; then
    printf '{}' |
      sudo -n /usr/local/libexec/pitv-helper tv-runtime-reset         >/tmp/pitv-runtime-reset.log 2>&1 || true
  fi
}

stop_child() {
  local pid="$1"
  [ -n "$pid" ] || return 0
  kill -0 "$pid" 2>/dev/null || return 0
  kill -TERM "$pid" 2>/dev/null || true
  for _ in $(seq 1 30); do
    kill -0 "$pid" 2>/dev/null || return 0
    sleep 0.1
  done
  kill -KILL "$pid" 2>/dev/null || true
}

shutdown_session() {
  STOPPING=1
  stop_child "$LAUNCHER_PID"
  stop_child "$LABWC_PID"
  runtime_cleanup
}

trap 'shutdown_session; exit 0' TERM INT HUP
trap 'rc=$?; [ "$STOPPING" -ne 0 ] || shutdown_session; exit "$rc"' EXIT

for _ in $(seq 1 100); do
  [ -d "$RUNTIME" ] && break
  sleep 0.1
done
[ -d "$RUNTIME" ] || {
  echo "PiTV runtime $RUNTIME neexistuje; user manager není připravený." >&2
  exit 3
}

systemctl --user start   dbus.socket pipewire.socket pipewire-pulse.socket wireplumber.service   >/dev/null 2>&1 || true

for _ in $(seq 1 100); do
  [ -S "$RUNTIME/bus" ] && [ -S "$RUNTIME/pulse/native" ] && break
  sleep 0.1
done

[ -S "$RUNTIME/bus" ] || {
  echo "PiTV user D-Bus není připravený." >&2
  exit 4
}
[ -S "$RUNTIME/pulse/native" ] || {
  echo "PiTV PipeWire/Pulse není připravený." >&2
  exit 5
}

# One recovery boundary for the complete TV session.
runtime_cleanup

labwc >>/tmp/pitv-labwc.log 2>&1 &
LABWC_PID=$!

WAYLAND=""
for _ in $(seq 1 150); do
  kill -0 "$LABWC_PID" 2>/dev/null || {
    echo "PiTV compositor skončil před vytvořením Wayland socketu." >&2
    exit 6
  }
  for socket in "$RUNTIME"/wayland-*; do
    if [ -S "$socket" ]; then
      WAYLAND="$(basename "$socket")"
      break 2
    fi
  done
  sleep 0.1
done

[ -n "$WAYLAND" ] || {
  echo "PiTV compositor nevytvořil Wayland socket." >&2
  exit 7
}
export WAYLAND_DISPLAY="$WAYLAND"

/usr/local/bin/pitv-launcher-run >>/tmp/pitv-launcher.log 2>&1 &
LAUNCHER_PID=$!

# If either half exits, systemd Restart=always recreates the complete shell.
set +e
wait -n "$LABWC_PID" "$LAUNCHER_PID"
RC=$?
set -e

if [ "$STOPPING" -eq 0 ]; then
  echo "PiTV TV session component exited rc=$RC; systemd will rebuild the shell." >&2
fi
exit "$RC"
