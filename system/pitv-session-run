#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -lt 1 ]; then
  echo "Použití: sudo pitv-session-run <příkaz> [argumenty...]" >&2
  exit 2
fi

if [ "$(id -u)" -ne 0 ]; then
  exec sudo -- "$0" "$@"
fi

id pitv >/dev/null 2>&1 || { echo "Uživatel pitv neexistuje." >&2; exit 3; }
PITV_UID="$(id -u pitv)"
RUNTIME="/run/user/$PITV_UID"

[ -d "$RUNTIME" ] || { echo "PiTV runtime $RUNTIME neexistuje." >&2; exit 4; }
[ -S "$RUNTIME/bus" ] || { echo "PiTV user D-Bus není aktivní." >&2; exit 5; }

MARKER="$RUNTIME/pitv-wayland-display"
WAYLAND="$(head -n1 "$MARKER" 2>/dev/null || true)"
if [[ ! "$WAYLAND" =~ ^wayland-[0-9]+$ ]] || [ ! -S "$RUNTIME/$WAYLAND" ]; then
  echo "Hlavní PiTV Wayland display není aktivní." >&2
  exit 6
fi

ENV_ARGS=(
  "HOME=/home/pitv"
  "USER=pitv"
  "LOGNAME=pitv"
  "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  "XDG_RUNTIME_DIR=$RUNTIME"
  "DBUS_SESSION_BUS_ADDRESS=unix:path=$RUNTIME/bus"
  "PULSE_RUNTIME_PATH=$RUNTIME/pulse"
  "XDG_SESSION_TYPE=wayland"
  "XDG_CURRENT_DESKTOP=labwc"
)
ENV_ARGS+=("WAYLAND_DISPLAY=$WAYLAND")

exec runuser -u pitv -- env -i "${ENV_ARGS[@]}" "$@"
