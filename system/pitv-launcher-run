#!/usr/bin/env bash
set -euo pipefail

if [ "$(id -un)" != "pitv" ]; then
  echo "PiTV launcher musí běžet jako uživatel pitv." >&2
  exit 2
fi

export HOME=/home/pitv
export USER=pitv
export LOGNAME=pitv
export PITV_SUPERVISED=1

: "${XDG_RUNTIME_DIR:?PiTV XDG_RUNTIME_DIR není nastavený}"
: "${WAYLAND_DISPLAY:?PiTV WAYLAND_DISPLAY není nastavený}"
[ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] || {
  echo "PiTV Wayland socket není dostupný." >&2
  exit 3
}

exec /usr/bin/python3 /opt/pitv/pitv/pitv.py
