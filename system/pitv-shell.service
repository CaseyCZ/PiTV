[Unit]
Description=PiTV TV Shell
After=systemd-user-sessions.service NetworkManager.service pitv-inputd.service pitv-displayd.service
Wants=NetworkManager.service pitv-inputd.service pitv-displayd.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=pitv
Group=pitv
SupplementaryGroups=video render input audio tty
PAMName=login
# PiTV's visual session never needs Linux capabilities.  A local PAM seat can
# grant CAP_WAKE_ALARM to regular users; descendants such as Flatpak/bwrap then
# reject the unexpected inherited capability.  Drop the complete capability
# set at the service boundary while device access remains group-based.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Environment=HOME=/home/pitv
Environment=USER=pitv
Environment=LOGNAME=pitv
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=labwc
Environment=SDL_VIDEODRIVER=wayland
ExecStart=/usr/local/bin/pitv-session
Restart=always
RestartSec=2
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=pitv.target
