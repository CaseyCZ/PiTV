[Unit]
Description=PiTV TV Shell
After=systemd-user-sessions.service NetworkManager.service pitv-inputd.service pitv-displayd.service
Wants=NetworkManager.service pitv-inputd.service pitv-displayd.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=pitv
Group=pitv
SupplementaryGroups=video render input audio tty
PAMName=login
# The PiTV launcher intentionally calls a narrow sudoers allowlist
# (/usr/local/libexec/pitv-helper and pitv-cec-control) for system operations
# such as Waydroid. Do not set NoNewPrivileges or an empty capability bounding
# set on the whole TV shell: both would also constrain those privileged child
# helpers. Capability isolation for Flatpak apps is handled outside this system
# service so it cannot break PiTV's privileged boundary.
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Environment=HOME=/home/pitv
Environment=USER=pitv
Environment=LOGNAME=pitv
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=labwc
Environment=SDL_VIDEODRIVER=wayland
# Remove stale compositor/Android readiness markers before this Type=simple
# service can be considered active. pitv-android-warm.service starts After=
# this unit, so it must never observe sockets/markers from the previous shell.
ExecStartPre=/bin/sh -c 'r=/run/user/$(id -u); rm -f "$r/pitv-wayland-display" "$r/pitv-waydroid-app-ready" "$r/pitv-waydroid-runtime-ready"'
ExecStart=/usr/local/bin/pitv-session
Restart=always
RestartSec=2
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=pitv.target
