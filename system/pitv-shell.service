[Unit]
Description=PiTV TV Shell
After=systemd-user-sessions.service NetworkManager.service
Wants=NetworkManager.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=pitv
Group=pitv
SupplementaryGroups=video render input audio tty
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Environment=HOME=/home/pitv
Environment=USER=pitv
Environment=LOGNAME=pitv
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=labwc
Environment=SDL_VIDEODRIVER=wayland
ExecStart=/usr/local/bin/pitv-session
Restart=always
RestartSec=2
StartLimitIntervalSec=0
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=pitv.target
